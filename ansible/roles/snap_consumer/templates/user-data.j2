#cloud-config
hostname: {{ vm_name }}

users:
  - name: {{ vm_user }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - {{ lookup('file', playbook_dir + '/../../vm/ssh/id_ed25519.pub') }}

write_files:
  - path: /etc/systemd/system/snap-consumer.service
    content: |
      [Unit]
      Description=Snap Consumer Trigger Server
      After=network-online.target snapd.service dbus.socket
      Wants=network-online.target

      [Service]
      Type=simple
      Environment=CONSUMER_NAME=consumer-ubuntu
      Environment=CONSUMER_DIR=/opt/snap-consumer
      Environment=BUILDER_URL=http://{{ vm_internal_gateway }}:9999
      Environment=SNAP_REGISTRY_URL={{ snap_registry_url }}
      Environment=WPT_FIREFOX_BINARY=/snap/firefox/current/lib/firefox/firefox
      Environment=WPT_GECKODRIVER_BINARY=/snap/firefox/current/lib/firefox/geckodriver
      Environment=LD_LIBRARY_PATH=/snap/firefox/current/lib/firefox
      ExecStartPre=+/bin/sh -c 'cd /opt/wpt && python3 ./wpt make-hosts-file >> /etc/hosts'
      ExecStart=/usr/bin/dbus-run-session /usr/bin/python3 /opt/snap-consumer/server.py
      Restart=on-failure
      RestartSec=5
      WorkingDirectory=/opt/snap-consumer

      [Install]
      WantedBy=multi-user.target
  - path: /opt/snap-consumer/server.py
    content: |
      #!/usr/bin/env python3
      import http.server, socketserver
      class H(http.server.BaseHTTPRequestHandler):
          def do_GET(self):
              if self.path == '/health':
                  self.send_response(200); self.end_headers(); self.wfile.write(b'OK')
              else:
                  self.send_response(404); self.end_headers()
          def do_POST(self):
              self.send_response(200); self.end_headers(); self.wfile.write(b'{}')
          def log_message(self, *a): pass
      with socketserver.TCPServer(('', 9000), H) as s: s.serve_forever()

package_update: true
packages:
  - snapd
  - python3
  - python3-pip
  - python3-venv
  - curl
  - git
  - dbus
  - libnss3-tools
  - libgtk-3-0t64
  - libdbus-glib-1-2
  - libxt6t64
  - libasound2t64
  - libx11-xcb1

bootcmd:
  - mkdir -p /opt/snap-consumer
  - echo "=== VM BOOT START ===" > /dev/ttyS0

runcmd:
  - echo "[cloud-init] Starting snap setup..." > /dev/ttyS0
  # Enable and start snapd
  - systemctl enable --now snapd.socket
  - echo "[cloud-init] snapd socket enabled" > /dev/ttyS0
  - systemctl enable --now snapd.service
  - echo "[cloud-init] snapd service enabled" > /dev/ttyS0
  - snap wait system seed.loaded
  - echo "[cloud-init] snap seed loaded" > /dev/ttyS0

  # Add builder hostname so shared scripts using http://builder:8888 resolve correctly
  - echo "{{ vm_internal_gateway }} builder" >> /etc/hosts

  # Clone WPT test suite
  - git clone --depth 1 --branch merge_pr_58944 https://github.com/web-platform-tests/wpt.git /opt/wpt
  - echo "[cloud-init] WPT cloned" > /dev/ttyS0
  - cd /opt/wpt && python3 ./wpt make-hosts-file >> /etc/hosts
  - chown -R {{ vm_user }}:{{ vm_user }} /opt/wpt
  - echo "[cloud-init] WPT hosts configured" > /dev/ttyS0

  # Create sudoers for consumer user
  - |
    echo '{{ vm_user }} ALL=(ALL) NOPASSWD: /opt/snap-consumer/upgrade.sh, /usr/bin/systemd-run' > /etc/sudoers.d/{{ vm_user }}

  # Service file written via write_files module (above)
  - echo "[cloud-init] Systemd service created" > /dev/ttyS0

  # Placeholder server.py written via write_files module (above)
  - chown {{ vm_user }}:{{ vm_user }} /opt/snap-consumer/server.py

  - systemctl daemon-reload
  - systemctl enable --now snap-consumer.service
  - echo "[cloud-init] Trigger server started" > /dev/ttyS0
  - echo "[cloud-init] READY" > /dev/ttyS0

final_message: "Snap consumer VM ready! Trigger server on port 9000"
