[Unit]
Description=Access Keys Monitor
After=network.target dbus.socket

[Service]
Type=simple
User=consumer
Group=consumer
Environment=CONSUMER_NAME=consumer-debian
ExecStartPre=+/bin/sh -c 'cd /opt/wpt && python3 ./wpt make-hosts-file >> /etc/hosts'
ExecStart=/usr/bin/dbus-run-session /usr/bin/python3 /home/consumer/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
